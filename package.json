{
  "name": "chess-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run client:dev",
    "build": "npm run client:build",
    "client:dev": "webpack serve --config client/webpack.config.mjs --mode=development",
    "client:build": "npm run lint && webpack --config client/webpack.config.mjs --mode=production",
    "server:dev": "npm --prefix server run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "npm run client:dev"
  },
  "dependencies": {
    "pixi.js": "^8.8.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.21.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.3",
    "prettier": "^3.5.3",
    "terser-webpack-plugin": "^5.3.12",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
